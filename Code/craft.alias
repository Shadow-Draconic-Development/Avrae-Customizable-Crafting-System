def search_list(query: str, item_list: list[str]) -> list[str]|None:
    """
    Searches for item in list.

    Args:
        query (str): The query being made
        item_list (list): List of items

    Return:
        list[str]|None: If it finds at least one match, it returns the item(s) in a list, otherwise it returns None
    """

    # Casefold query (so that number of total case folds is n+1)
    query = query.casefold()

    # Finds at least 1 match
    item_results = [item for item in item_list if query in item.casefold()]
    return item_results or None


def multiple_match_determine(search_result: list[str], target: str) -> str|None:
    """
    Determines if there is an exact match in search results
    
    Args:
        search_result (list[str]): List of search results
        target (str): Input value to match

    Returns:
        str|None: The exact match if found, otherwise None
    """

    # Casefold target (so that number of total case folds is n+1)
    target = target.casefold()

    # For each match in search result
    for match in search_result:

        # If exact match, return match
        if match.casefold() == target:
            return match


def grab_settings_dict() -> dict:
    """
    Loads settings dictionary

    Return:
        dict: Settings dictionary
    """

    # Tries to grab the svar
    settings_dict = load_json(get_svar("crafting_settings", default=get_gvar("d2daf66a-dce2-481b-ab28-f37ffe072de7")))

    # Default setting dictionary
    default_dict = {
        "lfg_integration": False,
        "pro_rate_refund": True,
        "success_dispType": "star",
        "failure_dispType": "hex",
        "jack_of_trades": True,
        "reliable_talent": False,
        "success_mod_threshold": {
            "-999": 1,
            "5": 2,
            "10": 3,
            "15": 4,
            "20": 5
        },
        "whitelisted_channel_ids": [],
        "parent_channel_inherit": False,
        "xp_categories": False,
        "max_history": 15
    }

    # For each default setting, load default
    for key, value in default_dict.items():
        settings_dict.setdefault(key, value)

    # If -999 is not in success mod threshold
    if "-999" not in settings_dict["success_mod_threshold"]:
        settings_dict["success_mod_threshold"]["-999"] = 1

    return settings_dict


def parse_money(money: str|int) -> list[str, float]:
    """
    Converts money amount into gold
    
    Args:
        money (str|int): Money amount
    
    Return:
        (list[str, float]): Money in gold
    
    """

    # Removes apostrophes in case someone is stupid
    money = str(money).replace(",", "")

    # Platinum
    money_split = money.lower().split("pp")
    if len(money_split) == 2:
        return ["Success", float(money_split[0]) * 10]

    # Gold
    else:
        money_split = money.lower().split("gp")
        if len(money_split) == 2:
            return ["Success", float(money_split[0])]

        # Silver
        else:
            money_split = money.lower().split("sp")
            if len(money_split) == 2:
                return ["Success", round(float(money_split[0]) / 10, 2)]

            # Copper
            else:
                money_split = money.lower().split("cp")
                if len(money_split) == 2:
                    return ["Success", round(float(money_split[0]) / 100, 2)]

                # Gold (with decimal)
                else:
                    try:
                        return ["Success", float(money_split[0])]
                    
                    # Not valid money
                    except:
                        return ["Error", "Program has problems parsing money, check money entry"]


def find_rarity_type_settings(craft_category: str, craft_type: str, settings_dict:dict) -> list[str]:
    """
    Grabs the settings for the rarity given.

    Args:
        craft_category (str): Crafting rarity
        craft_type (str): Crafting type
        settings_dict (dict): Settings dictionary

    Return:
        (list[str]): Result
    """

    # Create settings list
    settings_list = ["lfg_integration", "pro_rate_refund", "success_dispType", "failure_dispType", "jack_of_trades", "reliable_talent", "success_mod_threshold", "whitelisted_channel_ids", "parent_channel_inherit", "xp_categories", "max_history"]

    # Remove settings from item categories
    for key in settings_list:
        settings_dict.pop(key)

    # If there is an exact match of settings, return error
    if (search_result := search_list(craft_category, settings_list)):
        if (search_result2 := multiple_match_determine(search_result, craft_category)):
            return ["Error", "Invalid craft category"]

    # If there is at least one item category found
    if (search_result := search_list(craft_category, settings_dict.keys())):

        # If there is at most one item category found
        if len(search_result) == 1:
            craft_category = search_result[0]

        # If there are more than one item category found
        else:

            # If there is an exact match
            if (search_result2 := multiple_match_determine(search_result, craft_category)):
                craft_category = search_result2

            # If there is not an exact match
            else:
                search_result.insert(0, "**Multiple Categories Found:**")

                return ["Error", "\n".join(search_result)]

    # If no item categories are found
    else:
        return ["Error", f"Category not found (`{craft_category}`)"]

    # Coin based boolean
    coin_based = False

    # Try to convert all the types into floats, if it succeeds, then it is a coin based category
    try:
        for key in settings_dict[craft_category]:
            float(key)

        coin_based = True

    # If it fails, that it is a name based category
    except:
        pass

    # If it is not a coin based category
    if not coin_based:

        # If there is at least one item type found
        if (search_result := search_list(craft_type, settings_dict[craft_category].keys())):

            # If there is at most one item type found
            if len(search_result) == 1:
                return ["Success", craft_category, search_result[0]]

            # If there are more than one item type found
            else:
                
                # If there is an exact match
                if (search_result2 := multiple_match_determine(search_result, craft_type)):
                    return ["Success", craft_category, search_result2]

                # If there is no exact match
                else:
                    search_result.insert(0, "**Multiple Craft Types Found:**")

                    return ["Error", "\n".join(search_result)]

        # IF there are no item types found
        else:
            return ["Error", f"Type not found (`{craft_type}`)"]

    # If it is a coin based category
    else:

        # Parse money
        result_list = parse_money(craft_type)

        # If there was no error
        if result_list[0] != "Error":
            craft_list = []

            # For each cost threshold
            for key in settings_dict[craft_category]:

                # Try to pull the craft list for each threshold
                try:
                    if result_list[1] >= float(key):
                        craft_list = settings_dict[craft_category][key]

                except:
                    return ["Error", f"Non-float key in coin_based category (`{item_category}`) (within main settings dictionary)"]

            # If it pulls at least one craft list
            if craft_list != []:
                return ["Success", craft_category, craft_type]

            # If it cannot pull at least one craft list
            else:
                return ["Error", "Invalid cost input"]

        # If there was an error, pass it along
        else:
            return result_list


def capitalize_name(name: str) -> str:
    """
    Capitalizes name.
    
    Args:
        name: Name to capitalize.

    Return:
        (str): Capitalized name
    """

    # For multi-word names
    name_list_temp = name.split(" ")
    name_list = []

    # Each word gets lowercased and first letter capitalized
    for temp_name in name_list_temp:
        name_list.append(temp_name.lower().capitalize())

    return " ".join(name_list)


def create_cc_and_dict(item_name: str, craft_category: str, craft_type: str, settings_dict: dict, crafting_dict: dict, ch: character, crafting_cost: float, succ_mult: float) -> list[str]:
    """
    Creates/updates a crafting dictionary to refer to constantly

    Args:
        item_name (str): Name of item being crafted
        craft_category (str): Category of item being crafted
        craft_type (str): Type of item being crafted
        settings_dict (dict): Settings dictionary
        crafting_dict (dict): Old crafting dictionary
        ch (character): Character object
        crafting_cost (float): Cost of crafting
        succ_mult (float): Success multiplier

    Return:
        crafting_dict (dict): Updated crafting dictionary
    """

    # If crafting dictionary existed in a cvar
    if crafting_dict != dict():
        pass

    # If crafting dictionary did not exist in a cvar
    else:
        crafting_dict["history"] = []

    # Updates crafting dictionary information
    crafting_dict["name"] = item_name
    crafting_dict["category"] = craft_category
    crafting_dict["type"] = craft_type
    crafting_dict["time"] = 1687830660
    crafting_dict["cooldown"] = settings_dict[craft_category][craft_type][6]
    crafting_dict["warning"] = "Don't cheat, there is no reason to."
    crafting_dict["history"].insert(0, item_name)
    crafting_dict["crafting_cost"] = crafting_cost
    try:
        crafting_dict["color"] = settings_dict[craft_category][craft_type][8]

    except:
        try:
            crafting_dict["color"] = settings_dict[craft_category][craft_type][7]

        except:
            crafting_dict["color"] = ""

    try:
        crafting_dict["succ_mult"] = float(succ_mult)

    except:
        crafting_dict["succ_mult"] = 1.0

    # Create success CC
    ch.create_cc(
        name="Crafting: Successes", 
        minVal="0", 
        maxVal=str(ceil(settings_dict[craft_category][craft_type][4] * crafting_dict['succ_mult'])), 
        reset="none", 
        dispType=settings_dict["success_dispType"], 
        title=f"{item_name}'s Successes", 
        desc=f"Success Tracker for {item_name}", 
        initial_value="0"
    )

    # Create failure CC
    ch.create_cc(
        name="Crafting: Failures", 
        minVal="0", 
        maxVal=str(settings_dict[craft_category][craft_type][5]), 
        reset="none", 
        dispType=settings_dict["failure_dispType"], 
        title=f"{item_name}'s Failures", 
        desc=f"Failure Tracker for {item_name}", 
        initial_value="0"
    )

    return crafting_dict


def update_cc_settings(settings_dict: dict, item_category: str, item_type: str, ch: character, succ_mult: float) -> list[str]:
    """
    Updates CC settings

    Args:
        settings_dict (dict): Settings dictionary
        item_category (str): Item category
        item_type (str): Item type
        succ_mult (float): Success multiplier

    Return:
        (list[str]): Result
    """

    success_cc = ch.edit_cc(name="Crafting: Successes", maxVal=str(ceil(settings_dict[item_category][item_type][4] * succ_mult)), dispType=settings_dict["success_dispType"])
    failure_cc = ch.edit_cc(name="Crafting: Failures", maxVal=str(settings_dict[item_category][item_type][5]), dispType=settings_dict["failure_dispType"])

    return ["Success", success_cc, failure_cc]


def grab_stat_mod(stat_roll: str, jack_of_trades: bool, ch: character) -> list[int,str]:
    """
    Grabs the modifier for the stat requested

    Args:
        stat_roll (str): Skill name
        jack_of_trades (bool): Whether or not jack of trades is allowed 
        ch (character): Character object
    
    Return:
        (int): Skill modifier
    """
    
    # Sleight of hand alteration (to fit Avrae)
    if "sleight" in stat_roll.lower():
        stat_roll = "sleightOfHand"

    # Animal handling alteration (to fit Avrae)
    elif "animal" in stat_roll.lower():
        stat_roll = "animalHandling"

    if stat_roll.lower() not in ["", "none"]:
        # Tries to match the stat roll with the stat value and prof
        for (skill_name, skill) in ch.skills:
            if stat_roll.lower() in skill_name.lower() or skill_name.lower() in stat_roll.lower():
                mod = skill.value
                prof = skill.prof
                stat_roll = skill_name


        # Checks to see if mod and prof got found
        try:
            mod
            prof

        # If mod and prof did not get find
        except:
            mod = 0
            prof = 0

    else:
        mod = 0
        prof = 0

    # If jack of all trades is turned off and if the skill had JoAT
    if not jack_of_trades and prof == 0.5:
        mod += floor(proficiencyBonus / 2) * -1
 
    return [mod, stat_roll, prof]


def run_crafting_session(settings_dict: dict, crafting_dict: dict, ch: character, adv: int = 0, bonus: bool|str = False, ignore_restrictions: bool = False, stat_roll: bool|str = False) -> str[str]:
    """
    Runs a crafting session.

    Args:
        settings_dict (dict): Settings dictionary
        crafting_dict (dict): Crafting dictionary
        ch (character): Character object
        adv (int): Advantage level (-1: disadvantage, 0: normal (default), 1: Advantage, 2: Double Advantage)
        bonus (bool|str): If there is a bonus (default) | bonus dice/num 
        ignore_restrictions (bool): Whether or not to ignore restrictions (default: False)
    
    Return:
        (str[str]): Result
    """

    # Construct skill list
    skill_list = ["acrobatics", "animal handling", "arcana", "athletics", "deception", "history", "insight", "intimidation", "investigation", "medicine", "nature", "perception", "performance", "persuasion", "religion", "sleight of hand", "stealth", "survival", "strength", "dexterity", "constitution", "intelligence", "wisdom", "charisma"]

    # If stat_roll is not False, lowercase it
    if stat_roll:
        stat_roll = stat_roll.lower()
    
    # If stat roll is not none or empty
    if stat_roll and (stat_roll not in ["none", ""]):

        # Search skill list for skill
        if (search_result := search_list(stat_roll, skill_list)):

            # If there is exactly one match
            if len(search_result) == 1:
                crafting_dict["stat"] = search_result[0]

            # If there is more than one match
            else:
                crafting_dict["stat"] = ""

        # If there is no match
        else:
            crafting_dict["stat"] = ""

    # If the stat roll is not being changed or there is no skill
    else:
        if stat_roll == "none":
            crafting_dict["stat"] = ""

        else:
            if "stat" not in crafting_dict:
                crafting_dict["stat"] = ""

    # Search and grab mod
    mod_skill = grab_stat_mod(crafting_dict["stat"], settings_dict["jack_of_trades"], ch)

    # If there is a stat
    if mod_skill[1] != "" and mod_skill[1].lower() != "none":
        crafting_dict["stat"] = capitalize_name(mod_skill[1])

    # No stat, no mod
    else:
        mod_skill[0] = 0

    # Adds mod to bonus
    if bonus:
        bonus = f"{mod_skill[0]}+{bonus}"
    
    # Mod becomes bonus
    else:
        bonus = f"{mod_skill[0]}"

    reliable = False

    if settings_dict["reliable_talent"] and mod_skill[2] != 0 and ch.levels.get("Rogue") >= 11:
        reliable = True

    # Match case Halfling, advantage, and reliable
    match ["halfling" in ch.race.lower(), adv, reliable]:

        # Is a halfling, disadvantage, and no reliable talent
        case [True, -1, False]:
            dice_str = "2d20ro1kl1"

        # Is a halfling, disadvantage, and reliable talent
        case [True, -1, True]:
            dice_str = "2d20ro1kl1mi10"

        # Is a halfling, no advantage, and no reliable talent
        case [True, 0, False]:
            dice_str = "1d20ro1"

        # Is a halfling, no advantage, and reliable talent
        case [True, 0, True]:
            dice_str = "1d20ro1mi10"

        # Is a halfling, advantage, and no reliable talent
        case [True, 1, False]:
            dice_str = "2d20ro1kh1"

        # Is a halfling, advantage, and reliable talent
        case [True, 1, True]:
            dice_str = "2d20ro1kh1mi10"

        # Is a halfling, double advantage, and no reliable talent
        case [True, 2, False]:
            dice_str = "3d20ro1kh1"

        # Is a halfling, double advantage, and reliable talent
        case [True, 2, True]:
            dice_str = "3d20ro1kh1mi10"

        # Is not a halfling, disadvantage, and no reliable talent
        case [False, -1, False]:
            dice_str = "2d20kl1"

        # Is not a halfling, disadvantage, and reliable talent
        case [False, -1, True]:
            dice_str = "2d20kl1mi10"

        # Is not a halfling, no advantage, and no reliable talent
        case [False, 0, False]:
            dice_str = "1d20"

        # Is not a halfling, no advantage, and reliable talent
        case [False, 0, True]:
            dice_str = "1d20mi10"

        # Is not a halfling, advantage, and no reliable talent
        case [False, 1, False]:
            dice_str = "2d20kh1"
        
        # Is not a halfling, advantage, and reliable talent
        case [False, 1, True]:
            dice_str = "2d20kh1mi10"

        # Is not a halfling, double advantage, and not reliable talent
        case [False, 2, False]:
            dice_str = "3d20kh1"

        # Is not a halfling, double advantage, and reliable talent
        case [False, 2, True]:
            dice_str = "3d20kh1mi10"

        case _:
            err("Somehow, someway, the dice_str match-case broke. Please message ShadowsStride via his request form to fix this")

    # Roll d20 and bonus dice (if any)
    d20_dice_obj = vroll(dice_str)
    bonus_dice_obj = vroll(bonus)

    # Calculate total and construct roll string
    roll_total = d20_dice_obj.total + bonus_dice_obj.total
    roll_string = f"{d20_dice_obj.dice} + {bonus_dice_obj.dice} = `{roll_total}`"

    # If it beats the DC
    if roll_total >= settings_dict[crafting_dict["category"]][crafting_dict["type"]][1]:

        failure_mod = 0
        success = True

        # If it doesn't have problems with using threshold
        try:
            success_mod = -999
            excess = roll_total - settings_dict[crafting_dict["category"]][crafting_dict["type"]][1]

            for key, value in settings_dict["success_mod_threshold"].items():
                if excess >= int(key) and int(value) >= success_mod:
                    success_mod = int(value)

        # If it has problems with using threshold
        except:
            success_mod = 1

    # If it doesn't beat the DC
    else:
        success_mod = 0
        failure_mod = 1
        success = False

    # nat20 or nat1
    if d20_dice_obj.total in [1,20]:
        if d20_dice_obj.total == 1:
            success_mod -= abs(int(settings_dict[crafting_dict["category"]][crafting_dict["type"]][2]))

        else:
            success_mod += abs(int(settings_dict[crafting_dict["category"]][crafting_dict["type"]][3]))

    # Cap success mod at success mod thresholds
    if success_mod > max(settings_dict["success_mod_threshold"].values()):
        success_mod = max(settings_dict["success_mod_threshold"].values())

    # Modifies the CCs
    ch.cc("Crafting: Successes").mod(success_mod)
    ch.cc("Crafting: Failures").mod(failure_mod)

    # If ignore restrictions
    if ignore_restrictions:
        crafting_dict["bypass"] = True

        if crafting_dict["first"]:
            crafting_dict["time"] = int(round(time(), 0))
            crafting_dict["crafting_cost"] = 0
        
    # If it did not ignore restrictions
    else:
        crafting_dict["bypass"] = False
        crafting_dict["time"] = int(round(time(), 0))

    # Update cooldown
    crafting_dict["cooldown"] = settings_dict[crafting_dict["category"]][crafting_dict["type"]][6]

    # Update crafting dictionary
    ch.set_cvar("crafting_dict", dump_json(crafting_dict))

    # Tries to pull the color from the settings, defaulting to character csettings if fails.
    try:
        crafting_dict["color"] = settings_dict[craft_category][craft_type][8]

    except:
        try:
            crafting_dict["color"] = settings_dict[craft_category][craft_type][7]

        except:
            pass

    return ["Success", roll_string, success_mod, failure_mod, crafting_dict, success]


def main(input_list: list[str]) -> tuple[str]: 
    """
    Main program function
    
    Args:
        input_list (list[str]): List of inputs

    Return:
        str: Title
        str: Main body paragraph
        str: Image URL
        str: Color hex code
    """

    # Error image URL
    error_img = "https://raw.githubusercontent.com/Shadow-Draconic-Development/Avrae-Customizable-Crafting-System/refs/heads/main/Data/images/error.png"

    # Try to load character object
    try:
        ch = character()

    # If there is no character selected
    except:
        return "You Have Been Sneak Attacked by an Error", "You must have a character selected", error_img, "#CF142B"

    # Collect time and server prefix
    current_time = floor(time())
    prefix = ctx.prefix

    # Load settings dictionary
    settings_dict = grab_settings_dict()

    # If crafting CCs exist
    if ch.cc_exists("Crafting: Successes") and ch.cc_exists("Crafting: Failures"):

        # Load crafting CCs
        succ_cc = ch.cc("Crafting: Successes")
        fail_cc = ch.cc("Crafting: Failures")

        try:
            # Load crafting dict
            crafting_dict = load_json(ch.get_cvar("crafting_dict"))

        except:
            return "You Have Been Sneak Attacked by an Error", "Alias disconnect has occurred. Please delete the following CCs:\nCrafting: Successes\nCrafting: Failures", error_img, "#CF142B"

        # If max failures has been obtained
        if fail_cc.value == fail_cc.max:
            return "You Have Been Sneak Attacked by an Error", f"Maximum failures already reached for a(n) {crafting_dict['name']}.\n\nPlease run `{prefix}craft clear` as you have already ruined your materials.", "https://raw.githubusercontent.com/Shadow-Draconic-Development/Avrae-Customizable-Crafting-System/refs/heads/main/Data/images/fail.png", "#CF142B"

        # If required successes has been obtained
        elif succ_cc.value == succ_cc.max:

            # Try to grab color
            try:
                color = settings_dict[crafting_dict["category"]][crafting_dict["type"]][-1]

            except:
                pass

            return "You Have Been Sneak Attacked by an Error", f"You have already finished crafting a(n) {crafting_dict['name']}.\n\nPlease run `{prefix}craft clear` as you have already finished your item.", "https://raw.githubusercontent.com/Shadow-Draconic-Development/Avrae-Customizable-Crafting-System/refs/heads/main/Data/images/hammer.png", color

    # If there are at least one channel that is whitelisted
    if len(settings_dict["whitelisted_channel_ids"]) != 0:

        # Create placeholder for channel_id
        channel_id = 0

        # For each channel ID in settings dictionary
        for id_num in settings_dict["whitelisted_channel_ids"]:

            try:

                # If channel ID is present, set placeholder and break
                if (int_id_num := int(id_num)) == ctx.channel.id:
                    channel_id = ctx.channel.id
                    break

                # If number does not appear, check to see if parent channel inherit is on
                elif settings_dict["parent_channel_inherit"]:

                    # If parent channel is in channel list
                    if int_id_num == ctx.channel.parent.id:
                        channel_id = ctx.channel.parent.id
                        break

            # If there is a problem with one of the channel IDs being converted into an int
            except:
                pass

        # If placeholder is still 0 (no match was found)
        if channel_id == 0:

            # If the current channel is a thread
            if ctx.channel.parent:
                return "You Have Been Sneak Attacked by an Error", f"{ctx.channel.parent.name} is not a valid channel, nor is {ctx.channel.name} a valid thread to run this alias (or parent channel inherit is turned off).", error_img, "#CF142B"

            # If the current channel is not a thread
            else:
                return "You Have Been Sneak Attacked by an Error", f"{ctx.channel.name} is not a valid channel to run this alias.", error_img, "#CF142B"
    
    # If inputs were passed to the crafting alias
    if len(input_list) > 0:

        # Argparse all inputs
        args = argparse(" ".join(input_list))
        adv = args.adv(eadv=True)
        bonus = args.last("b", default=False)
        ignore_restrictions = args.last("i", default=False)
        cost_mod = args.last("c", default=1.0)
        succ_mod = args.last("succ", default=1.0)
        stat = args.last("s", default=False)
        guidance = args.last("guidance", default=False)

        # If guidance is added while there is also -b used
        if guidance and bonus:
            bonus += "+1d4"

        # If guidance is added
        elif guidance:
            bonus = "1d4"

        # Try to convert the cost_mod into a float
        try:
            cost_mod = float(cost_mod)

        # If cost_mod is not a number
        except:
            return "You Have Been Sneak Attacked by an Error", "Cost mod must be a number", error_img, "#CF142B"

        # Try to convert the succ_mod into a float
        try:
            succ_mod = abs(float(succ_mod))

        # If succ_mod is not a number
        except:
            return "You Have Been Sneak Attacked by an Error", "Success mod must be a number", error_img, "#CF142B"

            # if cost_mod == 0:
            #     return "You Have Been Sneak Attacked by an Error", "Cost mod cannot be zero", error_img, "#CF142B"

        # Extra args list for tidiness
        extra_args_list = ["-b", "-i", "adv", "dis", "eadv", "-c", "-s", "guidance"]

        # If first input is not in extra args list (it assumes it is a item name)
        if input_list[0].lower() not in extra_args_list:

            # If there aren't at least three inputs
            if len(input_list) < 3:
                return "You Have Been Sneak Attacked by an Error", "If you are wanting to start a new crafting session: Please input name, category, and type/cost.", error_img, "#CF142B"

            # If second and/or third input is in the extra args list (should be item category and item type/cost)
            if input_list[1].lower() in extra_args_list or input_list[2].lower() in extra_args_list:
                return "You Have Been Sneak Attacked by an Error", "If you are wanting to start a new crafting session: Please input name, category, and type/cost.", error_img, "#CF142B"

            # If crafting CCs already exist
            if ch.cc_exists("Crafting: Successes") or ch.cc_exists("Crafting: Failures"):
                return "You Have Been Sneak Attacked by an Error", "Crafting CCs already exist", error_img, "#CF142B"

            # Find rarity type settings
            result_list = find_rarity_type_settings(input_list[1], input_list[2], dict(settings_dict))

            # If there was no error
            if result_list[0] != "Error":

                # Readjust inputs to fit
                input_list[0] = capitalize_name(input_list[0])
                input_list[1] = result_list[1]
                input_list[2] = result_list[2]

            # If there was an error, pass it along
            else:
               return "You Have Been Sneak Attacked by an Error", result_list[1], error_img, "#CF142B"

            # Coin based type
            try:

                # For each key, try to turn it into a float
                for key in settings_dict[input_list[1]]:
                    float(key)

                # Parse money amount with cost mod
                cost = parse_money(float(input_list[2]) * cost_mod)

                # If there was no error
                if cost[0] != "Error":
                    cost[1] = cost[1] / 2

                # If there was an error
                else:
                    return "You Have Been Sneak Attacked by an Error", cost[1], error_img, "#CF142B" 

                # Grab cost threshold
                for key in settings_dict[input_list[1]]:
                    if cost[1] * 2 >= float(key):
                        input_list[2] = key

            # Name based type
            except:

                # Grab cost
                cost = parse_money(settings_dict[input_list[1]][input_list[2]][7] * cost_mod)

                # If there was no error
                if cost[0] != "Error":
                    cost[1] = cost[1] / 2

                # If there was an error
                else:
                    return "You Have Been Sneak Attacked by an Error", cost[1], error_img, "#CF142B" 

            # If level does not meet level restriction (and no ignore restrictions)
            if ch.levels.total_level < settings_dict[input_list[1]][input_list[2]][0] and not ignore_restrictions:
                return "You Have Been Sneak Attacked by an Error", f"You need to be at least level {settings_dict[input_list[1]][input_list[2]][0]} to craft this item", error_img, "#CF142B"

            # If crafting CVAR exists
            if (crafting_test := ch.get_cvar("crafting_dict")):

                # Load dictionary
                crafting_dict = load_json(crafting_test)

                # If time cooldown has not been exceeded
                if (time_after_cooldown := crafting_dict["time"] + crafting_dict["cooldown"]) > current_time and not ignore_restrictions:
                    return "You Have Been Sneak Attacked by an Error", f"You cannot have a crafting session until <t:{time_after_cooldown}:f>", error_img, "#CF142B"

            # If crafting CVAR does not exist
            else:
                crafting_dict = {}

            # If cost is greater than coin purse amount (and no ignore restrictions)
            if cost[1] > ch.coinpurse.total and not ignore_restrictions:
                return "You Have Been Sneak Attacked by an Error", "You have insufficient funds in order to craft this item", error_img, "#CF142B"

            # If cost is less than coin purse total (and no ignore restrictions)
            elif cost[1] <= ch.coinpurse.total and not ignore_restrictions:

                # Grab gold, silver, and copper amounts
                gold = floor(cost[1]) * -1
                silver = floor((cost[1] * 10) % 10) * -1
                copper = floor((cost[1] * 100) % 10) * -1

                # Subtract cost from coin purse
                ch.coinpurse.modify_coins(
                    gp=gold,
                    sp=silver,
                    cp=copper)

            # Create updated crafting dict and CC
            crafting_dict = create_cc_and_dict(input_list[0], input_list[1], input_list[2], settings_dict, crafting_dict, ch, cost[1], succ_mod)

            # Set first crafting flag to True
            crafting_dict["first"] = True

            # Run crafting session
            result_list = run_crafting_session(settings_dict, crafting_dict, ch, adv=adv, bonus=bonus, ignore_restrictions=ignore_restrictions, stat_roll=stat)

        # If the first input is not an item name (is an extra arg, not the first crafting session)
        else:

            # Argparse all inputs
            args = argparse(" ".join(input_list))
            adv = args.adv(eadv=True)
            bonus = args.last("b", default=False)
            ignore_restrictions = args.last("i", default=False)
            stat = args.last("s", default=False)
            guidance = args.last("guidance", default=False)

            # If guidance and bonus
            if guidance and bonus:
                bonus += "+1d4"

            # If guidance
            elif guidance:
                bonus = "1d4"

            # If crafting CCs exist, load crafting dictionary and set first crafting flag to False
            if ch.cc_exists("Crafting: Successes") and ch.cc_exists("Crafting: Failures"):
                try:
                    # Load crafting dict
                    crafting_dict = load_json(ch.get_cvar("crafting_dict"))

                except:
                    return "You Have Been Sneak Attacked by an Error", "Alias disconnect has occurred. Please delete the following CCs:\nCrafting: Successes\nCrafting: Failures", error_img, #CF142B

                crafting_dict["first"] = False

            # If crafting CCs do not exist
            else:
                return "You Have Been Sneak Attacked by an Error", "Crafting CCs not found, is this your first crafting session?", error_img, "#CF142B"

            # If cooldown has not been surpassed
            if (time_after_cooldown := settings_dict[crafting_dict["category"]][crafting_dict["type"]][6] + crafting_dict["time"]) > current_time and not ignore_restrictions:
                return f"You Have Been Sneak Attacked by an Error", f"You cannot have a crafting session until <t:{time_after_cooldown}:f>", error_img, "#CF142B"

            # Run crafting session
            result_list = run_crafting_session(settings_dict, crafting_dict, ch, adv=adv, bonus=bonus, ignore_restrictions=ignore_restrictions, stat_roll=stat)

    # If no inputs were passed (not first crafting session)
    else:

        # If crafting CCs exist, load crafting dictionary and set first crafting flag to False
        if ch.cc_exists("Crafting: Successes") and ch.cc_exists("Crafting: Failures"):

            try:
                # Load crafting dict
                crafting_dict = load_json(ch.get_cvar("crafting_dict"))

            except:
                return "You Have Been Sneak Attacked by an Error", "Alias disconnect has occurred. Please delete the following CCs:\nCrafting: Successes\nCrafting: Failures", error_img, "#CF142B"
                
            crafting_dict["first"] = False

        # If crafting CCs do not exist
        else:
            return "You Have Been Sneak Attacked by an Error", "Crafting CCs not found, is this your first crafting session?", error_img, "#CF142B"

        # If cooldown has not been surpassed
        if (time_after_cooldown := settings_dict[crafting_dict["category"]][crafting_dict["type"]][6] + crafting_dict["time"]) > current_time:
            return f"You Have Been Sneak Attacked by an Error", f"You cannot have a crafting session until <t:{time_after_cooldown}:f>", error_img, "#CF142B"

        # Run crafting session
        result_list = run_crafting_session(settings_dict, crafting_dict, ch)

    # Reload updated crafting dictionary
    crafting_dict = load_json(result_list[4])

    # If for some reason success multiplier is not in crafting dictionary, set it to 1.0
    if not "succ_mult" in crafting_dict:
        crafting_dict["succ_mult"] = 1.0

    # Update CC settings
    cc_test = update_cc_settings(settings_dict, crafting_dict["category"], crafting_dict["type"], ch, crafting_dict["succ_mult"])

    # If there were no errors, grab updated CCs
    if cc_test[0] != "Error":
        success_cc = cc_test[1]
        failure_cc = cc_test[2]

    # If there was an error, pass it along
    else:
        return f"You Have Been Sneak Attacked by an Error", cc_test[1], error_img, "#CF142B"

    # Empty list to contain output main body paragraph
    result_string = []

    # Header
    if result_list[5]:
        result_string.append("**Success**")
        
    else:
        result_string.append("**Failure**")

    # Tries to use crafting_dict["stat"]
    try:

        # If there is a stat being used
        if crafting_dict["stat"] != "":
            result_string.append(f"Skill used: {crafting_dict['stat']}")

        # If there is not a stat being used
        else:
            result_string.append("Skill used: None")

    # If there is an error, set skill used to none
    except:
        result_string.append("Skill used: None")


    # Display crafting DC
    result_string.append(f"DC: {settings_dict[crafting_dict['category']][crafting_dict['type']][1]}\n")

    result_string.append(result_list[1])
    result_string.append("")
    
    # Displays value of success (with change, if any)
    if result_list[2] > 0:
        result_string.append(f"Successes: {success_cc.value}/{success_cc.max} (+{result_list[2]})")
    elif result_list[2] < 0:
        result_string.append(f"Successes: {success_cc.value}/{success_cc.max} ({result_list[2]})")
    else:
        result_string.append(f"Successes: {success_cc.value}/{success_cc.max}")

    if f"{success_cc.value}/{success_cc.max}" != ch.cc_str("Crafting: Successes"):
        result_string.append(ch.cc_str("Crafting: Successes"))

    # Displays value of failure (with change, if any)
    if result_list[3] > 0:
        result_string.append(f"Failures: {failure_cc.value}/{failure_cc.max} (+{result_list[3]})")
    elif result_list[3] < 0:
        result_string.append(f"Failures: {failure_cc.value}/{failure_cc.max} ({result_list[3]})")
    else:
        result_string.append(f"Failures: {failure_cc.value}/{failure_cc.max}")

    if f"{failure_cc.value}/{failure_cc.max}" != ch.cc_str("Crafting: Failures"):
        result_string.append(ch.cc_str("Crafting: Failures"))

    # Checks to see if the failure counter is at max
    if failure_cc.value == failure_cc.max:
        result_string.append(f"\nMaximum failures reached for a {crafting_dict['name']}! Please run `!craft clear` as you have ruined your materials.")

    # Checks to see if the success counter is at max
    elif success_cc.value == success_cc.max:
        result_string.append(f"\nYou have finished crafting a {crafting_dict['name']}! Please run `!craft clear` as you have finished your item.")

    # If the bypass was used
    if crafting_dict["bypass"]:
        result_string.append("")
        result_string.append("`BYPASS USED`")
    else:
        pass

    # Next crafting session time
    result_string.append(f"\n**Next crafting session:** <t:{crafting_dict['time'] + crafting_dict['cooldown']}:f>")

    # Adds crafting cost details if first crafting and actually paid
    if crafting_dict["first"] and not crafting_dict["bypass"]:
        result_string.append("")

        if crafting_dict["crafting_cost"] == floor(crafting_dict["crafting_cost"]):
            result_string.append(f"{int(crafting_dict['crafting_cost'])}gp removed")

        else:
            result_string.append(f"{crafting_dict['crafting_cost']}gp removed")

    # If there is a character picture
    if image != "":
        img_url = image

    # If there is not a character picture
    else:
        img_url = "https://raw.githubusercontent.com/Shadow-Draconic-Development/Avrae-Customizable-Crafting-System/refs/heads/main/Data/images/main.png"

    # Tries to give it the color
    try:
        return f"{name}'s Crafting Session: {crafting_dict['name']}", "\n".join(result_string), img_url, crafting_dict["color"]

    # Default character color if it fails
    except:
        return f"{name}'s Crafting Session: {crafting_dict['name']}", "\n".join(result_string), img_url, color

           
# Main program
title, f, thumb, color = main(&ARGS&)
l = "<"
d = "-"


</drac2>
-title "{{title}}"
-f "{{f}}"
-thumb "{{thumb}}"
-color "{{color}}"
-footer "{{ctx.prefix}}craft {{l}}item name> {{l}}item category> {{l}}item type | cost> {{l}}{{d}}s skill> {{l}}eadv/adv/dis>{{"\n"}}4/5/26 | ShadowsStride"