embed
<drac2>
# *******************************************************
# * This work includes material written by Seth Hartman (aka ShadowsStride)
# * and is licensed under the Creative Commons Attribution 4.0 International License 
# * available at https://creativecommons.org/licenses/by/4.0/legalcode.
# *******************************************************


def grab_settings_dict() -> dict:
    """
    Loads settings dictionary

    Return:
        dict: Settings dictionary
    """

    # Tries to grab the svar
    settings_dict = load_json(get_svar("crafting_settings", default=get_gvar("d2daf66a-dce2-481b-ab28-f37ffe072de7")))

    # Default setting dictionary
    default_dict = {
        "lfg_integration": False,
        "pro_rate_refund": True,
        "success_dispType": "star",
        "failure_dispType": "hex",
        "jack_of_trades": True,
        "reliable_talent": False,
        "success_mod_threshold": {
            "-999": 1,
            "5": 2,
            "10": 3,
            "15": 4,
            "20": 5
        },
        "whitelisted_channel_ids": [],
        "parent_channel_inherit": False,
        "xp_categories": False,
        "max_history": 15
    }

    # For each default setting, load default
    for key, value in default_dict.items():
        settings_dict.setdefault(key, value)

    # If -999 is not in success mod threshold
    if "-999" not in settings_dict["success_mod_threshold"]:
        settings_dict["success_mod_threshold"]["-999"] = 1

    return settings_dict


def main(input_list: list[str], settings_dict = grab_settings_dict()) -> tuple[str]:
    """
    Main program function

    Args:
        input_list (list[str]): List of user inputs
        settings_dict = grab_settings_dict(): Settings dictionary

    Return:
        str: Title
        str: Main body paragraph
        str: Image URL
        str: Color hex code
    """

    error_img = "https://raw.githubusercontent.com/Shadow-Draconic-Development/Avrae-Customizable-Crafting-System/refs/heads/main/Data/images/error.png"


    try:
        ch = character()

    except:
        return "You Have Been Sneak Attacked by an Error", "You must have a character selected", error_img, "#CF142B"

    if (crafting_test := ch.get_cvar("crafting_dict")):
        crafting_dict = load_json(crafting_test)

    else:
        return "You Have Been Sneak Attacked by an Error", "Crafting CVAR `crafting_dict` is not present", error_img, "#CF142B"

    for name in crafting_dict["history"]:

        if name == crafting_dict["name"]:
            crafting_dict["history"][crafting_dict["history"].index(name)] += " <- Current/most Recent"
            break

    if "backup" in crafting_dict:

        if "success_cc" in crafting_dict["backup"] and "failure_cc" in crafting_dict["backup"] and "cvar" in crafting_dict["backup"]:

            if crafting_dict["backup"]["success_cc"][0] != crafting_dict["backup"]["success_cc"][1] and crafting_dict["backup"]["failure_cc"][0] != crafting_dict["backup"]["failure_cc"][1]:

                for name in crafting_dict["history"]:

                    if name == crafting_dict["backup"]["cvar"][0]:
                        crafting_dict["history"][crafting_dict["history"].index(name)] += " <- Stored in backup"

    # Splits the items into separate lists
    sep_list = [crafting_dict["history"][i:i+settings_dict["max_history"]] for i in range (0, len(crafting_dict["history"]), settings_dict["max_history"])]

    try:
        list_num = max(1, min(int(input_list[0]), len(sep_list)))

    except:
        list_num = 1

    sep_list[list_num - 1].insert(0, f"**List {list_num}/{len(sep_list)}**")

    # Joins results
    result_string = "\n".join(sep_list[list_num - 1])

    # Tries to pull a color
    try:
        if crafting_dict["color"] == "":
            color = color

        else:
            color = crafting_dict["color"]

    # Random color
    except:
        color = ch.color

    return f"{ch.name} checks their crafting history", result_string, "https://raw.githubusercontent.com/Shadow-Draconic-Development/Avrae-Customizable-Crafting-System/refs/heads/main/Data/images/history.png", color


# Main program
title, f, thumb, color = main(&ARGS&)
l = "<"


</drac2>
-title "{{title}}"
-f "{{f}}"
-thumb "{{thumb}}"
-color "{{color}}"
-footer "{{ctx.prefix}}craft history {{l}}#> | 4/5/26 | ShadowsStride"