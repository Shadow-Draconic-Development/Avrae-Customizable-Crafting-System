def search_list(query: str, item_list: list[str]) -> list[str]|None:
    """
    Searches for item in list.

    Args:
        query (str): The query being made
        item_list (list): List of items

    Return:
        list[str]|None: If it finds at least one match, it returns the item(s) in a list, otherwise it returns None
    """

    # Casefold query (so that number of total case folds is n+1)
    query = query.casefold()

    # Finds at least 1 match
    item_results = [item for item in item_list if query in item.casefold()]
    return item_results or None


def multiple_match_determine(search_result: list[str], target: str) -> str|None:
    """
    Determines if there is an exact match in search results
    
    Args:
        search_result (list[str]): List of search results
        target (str): Input value to match

    Returns:
        str|None: The exact match if found, otherwise None
    """

    # Casefold target (so that number of total case folds is n+1)
    target = target.casefold()

    # For each match in search result
    for match in search_result:

        # If exact match, return match
        if match.casefold() == target:
            return match


def grab_settings_dict() -> dict:
    """
    Loads settings dictionary

    Return:
        dict: Settings dictionary
    """

    # Tries to grab the svar
    settings_dict = load_json(get_svar("crafting_settings", default=get_gvar("d2daf66a-dce2-481b-ab28-f37ffe072de7")))

    # Default setting dictionary
    default_dict = {
        "lfg_integration": False,
        "pro_rate_refund": True,
        "success_dispType": "star",
        "failure_dispType": "hex",
        "jack_of_trades": True,
        "reliable_talent": False,
        "success_mod_threshold": {
            "-999": 1,
            "5": 2,
            "10": 3,
            "15": 4,
            "20": 5
        },
        "whitelisted_channel_ids": [],
        "parent_channel_inherit": False,
        "xp_categories": False,
        "max_history": 15
    }

    # For each default setting, load default
    for key, value in default_dict.items():
        settings_dict.setdefault(key, value)

    # If -999 is not in success mod threshold
    if "-999" not in settings_dict["success_mod_threshold"]:
        settings_dict["success_mod_threshold"]["-999"] = 1

    return settings_dict


def calc_time(time:int) -> str:
    """
    Converts seconds into hours, minutes, seconds.
    
    Args:
        time(int): Time in seconds

    Return:
        (str): Result
    """

    result_list = []

    # Converts time into hours, minutes, seconds
    hours = time // 3600
    minutes = (time % 3600) // 60
    seconds = (time % 3600) % 60

    # Hours
    if hours > 0:
        if hours != 1:
            result_list.append(f"{hours} hours")
        
        else:
            result_list.append(f"{hours} hour")

    # Minutes
    if minutes > 0:
        if minutes != 1:
            result_list.append(f"{minutes} minutes")
        
        else:
            result_list.append(f"{minutes} minute")

    # Seconds
    if seconds > 0:
        if seconds != 1:
            result_list.append(f"{seconds} seconds")
        
        else:
            result_list.append(f"{seconds} second")

    return ", ".join(result_list)


def find_category(category_name: str, _list: list) -> list[str]:
    """
    Searches for category
    
    Args:
        category_name (str): Name of category
        _list (str): List to search from

    Return:
        (list[str]): Result
    """

    # If it finds at least one match
    if (search_result := search_list(category_name, _list)):

        # If it finds exactly one match
        if len(search_result) == 1:
            return ["Success", search_result[0]]

        # If there is more than one match
        else:

            # If it finds an exact match
            if (search_result2 := multiple_match_determine(search_result, category_name)):
                return ["Success", search_result2]

            # If it does not find an exact match
            else:
                search_result.insert(0, "**Multiple Item Categories Found:**")

                return ["Error", "\n".join(search_result)]

    # If it finds no matches
    else:
        return ["Success", "None"]


def main(input_list: list, settings_dict: dict = grab_settings_dict()) -> tuple[str]:
    """
    Main program function

    Args:
        input_list (list): List of inputs
        settings_dict (dict): Settings dictionary (default: grab_settings_dict())

    Return:
        str: Title
        str: Main body paragraph
        str: Image URL
        str: Color hex code
    """

    # If a character is selected
    try:
        ch = character()

    # If a character is not selected
    except:
        color = ""

    # Image urls
    error_img = "https://raw.githubusercontent.com/Shadow-Draconic-Development/Avrae-Customizable-Crafting-System/refs/heads/main/Data/images/error.png"
    list_img = "https://raw.githubusercontent.com/Shadow-Draconic-Development/Avrae-Customizable-Crafting-System/refs/heads/main/Data/images/list.png"

    # Setup and header
    result_list = []
    settings_list = []

    # If there are no inputs, list all the categories and types (and settings)
    if len(input_list) == 0:

        result_list.append("**Bold** = Item Category (except for settings)")
        result_list.append("Normal = Item Type (except for settings)\n")

        # For each key, if the value for the key is not a dictionary and not success_mod_threshold
        for key in settings_dict:

            # If it is not a setting
            if typeof(settings_dict[key]) == "SafeDict" and not key in ["success_mod_threshold", "xp_categories"]:
                result_list.append(f"**{key}:**")

                # Uses a float to check to see that it is able to 
                for key2 in settings_dict[key]:

                    # If it is cost-based category
                    try:
                        if float(key2) == floor(key2):
                            result_list.append(f"{int(key2)}gp")

                        else:
                            result_list.append(f"{float(key2)}gp")
                        cost_based = True

                    # If it is not a cost-based category
                    except:
                        result_list.append(key2)
                        cost_based = False
                    
                if cost_based:
                    result_list.append("(Thresholds)")

                result_list.append("")

            # If it is a setting
            else:
                settings_list.append(key)

        # Header for settings
        result_list.append("\n**Settings:**")

        # Adds settings to result_list
        for setting in settings_list:
            result_list.append(setting)

        return "Crafting Options and Settings", "\n".join(result_list), list_img, color
    
    # If we are looking for a specific category/setting
    else:


        # If we find a match
        if (search_result := search_list(input_list[0], settings_dict.keys())):

            # If we find exactly one match
            if len(search_result) == 1:
                input_list[0] = search_result[0]

            # If we find multiple matches
            else:

                # If we find an exact match
                if (search_result2 := multiple_match_determine(search_result, input_list[0])):
                    input_list[0] = search_result2

                # If we do not find an exact match
                else:
                    search_result.insert(0, "**Multiple Settings Found:**")

                    return "You Have Been Sneak Attacked by an Error", "\n".join(search_result), error_img, "#CF142B"

        # If we do not find a match
        else:
            return main([])

        if input_list[0] in ["lfg_integration", "pro_rate_refund", "success_dispType", "failure_dispType", "jack_of_trades", "reliable_talent", "success_mod_threshold", "whitelisted_channel_ids", "parent_channel_inherit", "xp_categories", "max_history"]:


            # Header
            result_list.append(f"**{input_list[0]}:**")

            # If it is a string value
            if typeof(settings_dict[input_list[0]]) in ["str", "int"]:
                result_list.append(str(settings_dict[input_list[0]]))

            # If it is a boolean value
            elif typeof(settings_dict[input_list[0]]) == "bool":
                if settings_dict[input_list[0]]:
                    result_list.append("On")

                else:
                    result_list.append("Off")

            # If it is a dictionary value
            elif typeof(settings_dict[input_list[0]]) == "SafeDict":
                for key, value in settings_dict[input_list[0]].items():

                    # If it is a string value
                    if typeof(key) == "str":

                        if key != "-999":
                            result_list.append(f"**{key}:** {value}")
                        
                        elif key == "-999" and not "0" in settings_dict[input_list[0]]:
                            result_list.append(f"**0:** {value}")

                    # If it is a list value
                    elif typeof(key) != "SafeDict":
                        result_list.append(f"**{key}:**")
                        for item in settings_dict[input_list[0]][key]:
                            result_list.append(item)

                        result_list.append("")

                    # If it is a dict value
                    else:
                        result_list.append("Shadow has not setup this yet as there is not a use case for this dict value, message him to address this")

            # If it is a list value:
            else:
                for item in settings_dict[input_list[0]]:
                    result_list.append(item)

            return f"Settings For {input_list[0]}", "\n".join(result_list), list_img, color 
        
        # If it is a item category
        else:
            
            # If there is an item type provided
            if len(input_list) > 1:

                # If it finds at least one item type
                if (search_result := search_list(input_list[1], settings_dict[input_list[0]].keys())):

                    # If it finds exactly one item type
                    if len(search_result) == 1:
                        input_list[1] = search_result[0]

                    # If it finds more than one item type
                    else:

                        # If it finds exactly one item type
                        if (search_result2 := multiple_match_determine(search_result, input_list[1])):
                            input_list[2] = search_result2

                        # If it doesn't find exactly one item type
                        else:
                            search_result.insert(0, "**Multiple Item Types Found:**")

                            return "You Have Been Sneak Attacked by an Error", "\n".join(search_result), error_img, "#CF142B"

                # If it doesn't find an item type
                else:
                    return main([input_list[0]])

                # List settings for the item type
                result_list.append(f"**Settings For {input_list[0]} - {input_list[1]}:**")
                result_list.append(f"Level Requirement: {settings_dict[input_list[0]][input_list[1]][0]}")
                result_list.append(f"DC: {settings_dict[input_list[0]][input_list[1]][1]}")
                result_list.append(f"Nat1 Penalty: {settings_dict[input_list[0]][input_list[1]][2]}")
                result_list.append(f"Nat20 Bonus: {settings_dict[input_list[0]][input_list[1]][3]}")
                result_list.append(f"Successes Needed: {settings_dict[input_list[0]][input_list[1]][4]}")
                result_list.append(f"Maximum Failures Allotted: {settings_dict[input_list[0]][input_list[1]][5]}")
                result_list.append(f"Cooldown: {calc_time(settings_dict[input_list[0]][input_list[1]][6])}")

                # If it is a type based item type
                if len(settings_dict[input_list[0]][input_list[1]]) == 9:

                    color = settings_dict[input_list[0]][input_list[1]][8]
                    result_list.append(f"Retail Item Cost: {settings_dict[input_list[0]][input_list[1]][7]}gp")
                    result_list.append(f"Hex Color: {settings_dict[input_list[0]][input_list[1]][8]}")

                # If it is a cost based item type
                else:
                    result_list.append(f"Hex Color: {settings_dict[input_list[0]][input_list[1]][7]}")
                    color = settings_dict[input_list[0]][input_list[1]][7]

            # If only item category was provided
            else:
                result_list.append(f"**Settings For {input_list[0]}:**")

                # For each item type, list item settings
                for item_type in settings_dict[input_list[0]]:
                    result_list.append(f"**{item_type}:**")

                    result_list.append(f"Level Requirement: {settings_dict[input_list[0]][item_type][0]}")
                    result_list.append(f"DC: {settings_dict[input_list[0]][item_type][1]}")
                    result_list.append(f"Nat1 Penalty: {settings_dict[input_list[0]][item_type][2]}")
                    result_list.append(f"Nat20 Bonus: {settings_dict[input_list[0]][item_type][3]}")
                    result_list.append(f"Successes Needed: {settings_dict[input_list[0]][item_type][4]}")
                    result_list.append(f"Maximum Failures Allotted: {settings_dict[input_list[0]][item_type][5]}")
                    result_list.append(f"Cooldown: {calc_time(settings_dict[input_list[0]][item_type][6])}")

                    # If it is a type based item type
                    if len(settings_dict[input_list[0]][item_type]) == 9:
                        result_list.append(f"Retail Item Cost (crafting cost is half of this): {settings_dict[input_list[0]][item_type][7]}gp")
                        result_list.append(f"Hex Color: {settings_dict[input_list[0]][item_type][8]}\n")
                    
                    # If it is a cost based item type
                    else:
                        result_list.append(f"Hex Color: {settings_dict[input_list[0]][item_type][7]}\n")

            return "Viewing Settings", "\n".join(result_list), list_img, color


# Main program
title, f, thumb, color = main(&ARGS&)
l = "<"

</drac2>a
-title "{{title}}"
-f "{{f}}"
-thumb "{{thumb}}"
-color "{{color}}"
-footer "{{ctx.prefix}}craft list {{l}}item category/setting> {{l}}item type> | 4/4/26 | ShadowsStride"