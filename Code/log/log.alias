embed
<drac2>
# *******************************************************
# * This work includes material written by Seth Hartman (aka ShadowsStride)
# * and is licensed under the Creative Commons Attribution 4.0 International License 
# * available at https://creativecommons.org/licenses/by/4.0/legalcode.
# *******************************************************


def main() -> tuple[str]:
    """
    Main program function

    Return:
        str: Title
        str: Main body paragraph
        str: Image URL
        str: Hex color code
    """

    # Error image and server prefix
    error_img = "https://raw.githubusercontent.com/Shadow-Draconic-Development/Avrae-Customizable-Crafting-System/refs/heads/main/Data/images/error.png"
    prefix = ctx.prefix

    # Load character 
    try:
        ch = character()

    # If no character is selected
    except:
        return "You Have Been Sneak Attacked by an Error", "You must have a character selected", error_img, "#CF142B"

    # Check to see if crafting CCs exist
    if ch.cc_exists("Crafting: Successes") and ch.cc_exists("Crafting: Failures"):

        # Try to load crafting dictionary
        try:
            crafting_dict = load_json(ch.get_cvar("crafting_dict"))

        # If, for some reason, the crafting dictionary doesn't load properly
        except:
            return "You Have Been Sneak Attacked by an Error", "Alias disconnect has occurred. Please delete the following CCs:\nCrafting: Successes\nCrafting: Failures", error_img, "#CF142B"

        # Load crafting CCs
        success_cc = ch.cc("Crafting: Successes")
        failure_cc = ch.cc("Crafting: Failures")

    # If crafting CCs do not exist
    else:
        return "You Have Been Sneak Attacked by an Error", "No crafting project in progress", error_img, "#CF142B"

    # Load success CC details
    result_string = [f"Successes: {success_cc.value}/{success_cc.max}"]

    # Check to see if the success CC matches an already added CC details
    if f"{success_cc.value}/{success_cc.max}" != (success_cc_str := ch.cc_str("Crafting: Successes")):
        result_string.append(success_cc_str)

    # Load failure CC details
    result_string.append(f"Failures: {failure_cc.value}/{failure_cc.max}")
    
    # Check to see if the failure CC matches an already added CC details
    if f"{failure_cc.value}/{failure_cc.max}" != (failure_cc_str := ch.cc_str("Crafting: Failures")):
        result_string.append(failure_cc_str)

    # If maximum failures were reached
    if failure_cc.value == failure_cc.max:
        result_string.append(f"\nMaximum failures reached for a {crafting_dict['name']}! Please run `{prefix}craft clear` as you have ruined your materials.")
        img_url = "https://raw.githubusercontent.com/Shadow-Draconic-Development/Avrae-Customizable-Crafting-System/refs/heads/main/Data/images/error.png"

    # If minimum successes were reached
    elif success_cc.value == success_cc.max:
        result_string.append(f"\nYou have finished crafting a {crafting_dict['name']}! Please run `{prefix}craft clear` as you have finished your item.")
        img_url = "https://raw.githubusercontent.com/Shadow-Draconic-Development/Avrae-Customizable-Crafting-System/refs/heads/main/Data/images/hammer.png"

    # If neither were reached
    else:
        img_url = "https://raw.githubusercontent.com/Shadow-Draconic-Development/Avrae-Customizable-Crafting-System/refs/heads/main/Data/images/main.png"

    # If bypass was used
    if crafting_dict["bypass"]:
        result_string.append("\n`BYPASS USED`")

    # Legacy check for color
    try:
        color = crafting_dict["color"]

    except:
        color = color

    # If there is a backup
    if "backup" in crafting_dict:

        # Check to see if there is a backup that can be restored (will just be displayed)
        if crafting_dict["backup"]["success_cc"][0] != crafting_dict["backup"]["success_cc"][1] and crafting_dict["backup"]["failure_cc"][0] != crafting_dict["backup"]["failure_cc"][1]:
            result_string.append(f"`Item in backup: {crafting_dict['backup']['cvar'][0]}`")

    return f"{name} Checks Their Crafting Progress With Their {crafting_dict['name']}", "\n".join(result_string), img_url, color
        

# Main program
title, f, thumb, color = main()


</drac2>
-title "{{title}}"
-f "{{f}}"
-thumb "{{thumb}}"
-color "{{color}}"
-footer "{{ctx.prefix}}craft log | 4/5/26 | ShadowsStride"