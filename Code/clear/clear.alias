def multiple_match_determine(search_result: list[str], target: str) -> str|None:
    """
    Determines if there is an exact match in search results
    
    Args:
        search_result (list[str]): List of search results
        target (str): Input value to match

    Returns:
        str|None: The exact match if found, otherwise None
    """

    # Casefold target (so that number of total case folds is n+1)
    target = target.casefold()

    # For each match in search result
    for match in search_result:

        # If exact match, return match
        if match.casefold() == target:
            return match


def add_xp_func(amount: float, ch: character) -> str[list]:
    """
    Adds xp to cvars

    Args:
        amount (float): Amount of xp to give
        ch (character): Character object
    
    Return:
        (list[str]): Result
    """

    # Imports xp module
    using(
        xplib="bd5e6af1-55e9-4c5b-b814-8f9b447091e7"
    )

    # Confirms it is a positive float
    try:
        amount = float(abs(amount))

    except:
        return ['Error', 'Non-number detected with adding xp']

    # Add xp
    xplib.modify_xp(amount)

    # Reformat if an integer
    if floor(amount) == amount:
        amount = int(amount)

    return ["Success", f"{amount}xp rewarded"]


def grab_settings_dict() -> dict:
    """
    Loads settings dictionary

    Return:
        dict: Settings dictionary
    """

    # Tries to grab the svar
    settings_dict = load_json(get_svar("crafting_settings", default=get_gvar("d2daf66a-dce2-481b-ab28-f37ffe072de7")))

    # Default setting dictionary
    default_dict = {
        "lfg_integration": False,
        "pro_rate_refund": True,
        "success_dispType": "star",
        "failure_dispType": "hex",
        "jack_of_trades": True,
        "reliable_talent": False,
        "success_mod_threshold": {
            "-999": 1,
            "5": 2,
            "10": 3,
            "15": 4,
            "20": 5
        },
        "whitelisted_channel_ids": [],
        "parent_channel_inherit": False,
        "xp_categories": False,
        "max_history": 15
    }

    # For each default setting, load default
    for key, value in default_dict.items():
        settings_dict.setdefault(key, value)

    # If -999 is not in success mod threshold
    if "-999" not in settings_dict["success_mod_threshold"]:
        settings_dict["success_mod_threshold"]["-999"] = 1

    return settings_dict


def main() -> tuple[str]:
    """
    Main program function
    
    Return:
        str: Title
        str: Main Body Paragraph
        str: Image URL
        str: Hex color code     
    """

    error_img = "https://raw.githubusercontent.com/Shadow-Draconic-Development/Avrae-Customizable-Crafting-System/refs/heads/main/Data/images/error.png"

    try:
        ch = character()

    except:
        return "You Have Been Sneak Attacked by an Error", "You must have a character selected", error_img, "#CF142B"

    if not ch.cc_exists("Crafting: Successes") or not ch.cc_exists("Crafting: Failures"):
        return "You Have Been Sneak Attacked by an Error", "Crafting CCs don't exist", error_img, "#CF142B"

    # Tries to grab the svar
    settings_dict = grab_settings_dict()

    try:
        crafting_dict = load_json(ch.get_cvar("crafting_dict"))

    except:
        return "You Have Been Sneak Attacked by an Error", "Alias disconnect has occurred. Please delete the following CCs:\nCrafting: Successes\nCrafting: Failures", error_img, "#CF142B"

    success_cc = ch.cc("Crafting: Successes")
    failure_cc = ch.cc("Crafting: Failures")

    # If there are at least one channel that is whitelisted
    if len(settings_dict["whitelisted_channel_ids"]) != 0:

        # Create placeholder for channel_id
        channel_id = 0

        # For each channel ID in settings dictionary
        for id_num in settings_dict["whitelisted_channel_ids"]:

            try:

                # If channel ID is present, set placeholder and break
                if (int_id_num := int(id_num)) == ctx.channel.id:
                    channel_id = ctx.channel.id
                    break

                # If number does not appear, check to see if parent channel inherit is on
                elif settings_dict["parent_channel_inherit"]:

                    # If parent channel is in channel list
                    if int_id_num == ctx.channel.parent.id:
                        channel_id = ctx.channel.parent.id
                        break

            # If there is a problem with one of the channel IDs being converted into an int
            except:
                pass

        # If placeholder is still 0 (no match was found)
        if channel_id == 0:

            # If the current channel is a thread
            if ctx.channel.parent:
                return "You Have Been Sneak Attacked by an Error", f"{ctx.channel.parent.name} is not a valid channel, nor is {ctx.channel.name} a valid thread to run this alias (or parent channel inherit is turned off).", error_img, "#CF142B"

            # If the current channel is not a thread
            else:
                return "You Have Been Sneak Attacked by an Error", f"{ctx.channel.name} is not a valid channel to run this alias.", error_img, "#CF142B"

    if settings_dict["pro_rate_refund"] and success_cc.value != success_cc.max and failure_cc.value != failure_cc.max and crafting_dict["crafting_cost"] != 0:

        percentage_back = (1 - ((success_cc.value / success_cc.max) + (failure_cc.value /(failure_cc.max * 2)))) * .5

        if percentage_back < 0:
            money_back = 0

        else:
            money_back = round(percentage_back * crafting_dict["crafting_cost"], 2)

            # Grab gold, silver, and copper amounts
            gold = floor(money_back)
            silver = floor((money_back * 10) % 10)
            copper = floor((money_back * 100) % 10)

            # Add cost to coinpurse
            ch.coinpurse.modify_coins(
                gp=gold,
                sp=silver,
                cp=copper)

    else:
        money_back = 0

    if not "stat" in crafting_dict:
        crafting_dict["stat"] = ""

    if not "succ_mult" in crafting_dict:
        crafting_dict["succ_mult"] = 1.0

    crafting_dict["backup"] = {
        "cvar": [
            crafting_dict["name"],
            crafting_dict["category"],
            crafting_dict["type"],
            crafting_dict["time"],
            crafting_dict["cooldown"],
            crafting_dict["crafting_cost"],
            crafting_dict["stat"],
            crafting_dict["succ_mult"]
        ],
        "success_cc": [
            success_cc.value,
            success_cc.max,
            success_cc.desc,
            success_cc.title
        ],
        "failure_cc": [
            failure_cc.value,
            failure_cc.max,
            failure_cc.desc,
            failure_cc.title
        ],
        "money_back": money_back
    }

    ch.delete_cc("Crafting: Successes")
    ch.delete_cc("Crafting: Failures")

    ch.set_cvar("crafting_dict", dump_json(crafting_dict))
    crafting_dict = load_json(ch.get_cvar("crafting_dict"))

    try:
        color = settings_dict[crafting_dict["backup"]["svar"][1]][crafting_dict["backup"]["svar"][2]][-1]

    except:
        color = color

    if money_back > 0:
        return f"{name} Has Cleared Their Crafting Progress for a {crafting_dict['name']}", f"Prorated refund: {money_back}gp", "https://raw.githubusercontent.com/Shadow-Draconic-Development/Avrae-Customizable-Crafting-System/refs/heads/main/Data/images/coin_bag.png", color

    elif crafting_dict["backup"]["success_cc"][0] == crafting_dict["backup"]["success_cc"][1]:

        try:
            crafting_dict["backup"]["cvar"][5] = round(float(settings_dict[crafting_dict["backup"]["cvar"][1]][crafting_dict["backup"]["cvar"][2]][7]) / 2, 2)

        except:
            pass

        # If xp given out is allowed
        if settings_dict["xp_categories"]:

            add_xp = False

            # Match type of what xp_categories is
            match typeof(settings_dict["xp_categories"]):

                # If it's a boolean, it has to be true
                case "bool":
                    add_xp = True

                # If there is a dictionary
                case "SafeDict":

                    # If it finds the category in the dictionary
                    if (search_result := multiple_match_determine(settings_dict["xp_categories"].keys(), crafting_dict["backup"]["cvar"][1])):

                        # 
                        if typeof(settings_dict["xp_categories"][search_result[0]]) == "str":

                            if settings_dict["xp_categories"][search_result[0]] == "all":
                                add_xp = True

                            elif settings_dict["xp_categories"][search_result[0]].casefold() == crafting_dict["backup"]["cvar"][2].casefold():
                                add_xp = True

                        else:
                            if (search_result2 := multiple_match_determine(settings_dict["xp_categories"][search_result[0]],crafting_dict["backup"]["cvar"][2])):
                                add_xp = True

                case "SafeList":

                    if (search_result := multiple_match_determine(settings_dict["xp_categories"], crafting_dict["backup"]["cvar"][1])):
                        add_xp = True

                case _:
                    if settings_dict["xp_categories"].lower() == "all":
                        add_xp = True

                    elif settings_dict["xp_categories"].casefold() == crafting_dict["backup"]["cvar"][1].casefold():
                        add_xp = True

            if add_xp and crafting_dict["backup"]["cvar"][5] != 0:
                result_list = add_xp_func(crafting_dict["backup"]["cvar"][5], ch)

                return f"{name} Cleared Their Crafting Progress", result_list[1], "https://raw.githubusercontent.com/Shadow-Draconic-Development/Avrae-Customizable-Crafting-System/refs/heads/main/Data/images/hammer.png", color

            else:
                return f"{name} Cleared Their Crafting Progress", "", "https://raw.githubusercontent.com/Shadow-Draconic-Development/Avrae-Customizable-Crafting-System/refs/heads/main/Data/images/hammer.png", color

        else:
            return f"{name} Cleared Their Crafting Progress", "", "https://raw.githubusercontent.com/Shadow-Draconic-Development/Avrae-Customizable-Crafting-System/refs/heads/main/Data/images/hammer.png", color

    else:
        return f"{name} Cleared Their Crafting Progress", "", "https://raw.githubusercontent.com/Shadow-Draconic-Development/Avrae-Customizable-Crafting-System/refs/heads/main/Data/images/fail.png", color
    

# Runs main program
title, f, thumb, color = main()


</drac2>
-title "{{title}}"
-f "{{f}}"
-thumb "{{thumb}}"
-color "{{color}}"
-footer "{{ctx.prefix}}craft clear | 4/5/26 | ShadowsStride"