# * available at https://creativecommons.org/licenses/by/4.0/legalcode.
# *******************************************************


def grab_settings_dict() -> dict:
    """
    Loads settings dictionary

    Return:
        dict: Settings dictionary
    """

    # Tries to grab the svar
    settings_dict = load_json(get_svar("crafting_settings", default=get_gvar("d2daf66a-dce2-481b-ab28-f37ffe072de7")))

    # Default setting dictionary
    default_dict = {
        "lfg_integration": False,
        "pro_rate_refund": True,
        "success_dispType": "star",
        "failure_dispType": "hex",
        "jack_of_trades": True,
        "reliable_talent": False,
        "success_mod_threshold": {
            "-999": 1,
            "5": 2,
            "10": 3,
            "15": 4,
            "20": 5
        },
        "whitelisted_channel_ids": [],
        "parent_channel_inherit": False,
        "xp_categories": False,
        "max_history": 15
    }

    # For each default setting, load default
    for key, value in default_dict.items():
        settings_dict.setdefault(key, value)

    # If -999 is not in success mod threshold
    if "-999" not in settings_dict["success_mod_threshold"]:
        settings_dict["success_mod_threshold"]["-999"] = 1

    return settings_dict


def main() -> tuple[str]:
    """
    Main program function

    Return:
        str: Title
        str: Main body paragraph
        str: Image URL
        str: Color hex code
    """

    error_img = "https://raw.githubusercontent.com/Shadow-Draconic-Development/Avrae-Customizable-Crafting-System/refs/heads/main/Data/images/error.png"

    # Try to load character object
    try:
        ch = character()

    # If there is no character selected
    except:
        return "You Have Been Sneak Attacked by an Error", "You must have a character selected", error_img, "#CF142B"


    if (crafting_test := ch.get_cvar("crafting_dict")):
        crafting_dict = load_json(crafting_test)

        if not "backup" in crafting_dict:
            return "You Have Been Sneak Attacked by an Error", "Backup not found", error_img, "#CF142B"

    else:
        return "You Have Been Sneak Attacked by an Error", "Crafting CVAR does not exist", error_img, "#CF142B"


    settings_dict = grab_settings_dict()

    # If there are at least one channel that is whitelisted
    if len(settings_dict["whitelisted_channel_ids"]) != 0:

        # Create placeholder for channel_id
        channel_id = 0

        # For each channel ID in settings dictionary
        for id_num in settings_dict["whitelisted_channel_ids"]:

            try:

                # If channel ID is present, set placeholder and break
                if (int_id_num := int(id_num)) == ctx.channel.id:
                    channel_id = ctx.channel.id
                    break

                # If number does not appear, check to see if parent channel inherit is on
                elif settings_dict["parent_channel_inherit"]:

                    # If parent channel is in channel list
                    if int_id_num == ctx.channel.parent.id:
                        channel_id = ctx.channel.parent.id
                        break

            # If there is a problem with one of the channel IDs being converted into an int
            except:
                pass

        # If placeholder is still 0 (no match was found)
        if channel_id == 0:

            # If the current channel is a thread
            if ctx.channel.parent:
                return "You Have Been Sneak Attacked by an Error", f"{ctx.channel.parent.name} is not a valid channel, nor is {ctx.channel.name} a valid thread to run this alias (or parent channel inherit is turned off).", error_img, "#CF142B"

            # If the current channel is not a thread
            else:
                return "You Have Been Sneak Attacked by an Error", f"{ctx.channel.name} is not a valid channel to run this alias.", error_img, "#CF142B"

    if crafting_dict["backup"]["success_cc"][0] == crafting_dict["backup"]["success_cc"][1] or crafting_dict["backup"]["failure_cc"][0] == crafting_dict["backup"]["failure_cc"][1]:
        return "You Have Been Sneak Attacked by an Error", "You cannot restore a failed/restored item", error_img, "#CF142B"

    # If the CCs already exist (aka restore during a current crafting session)
    if ch.cc_exists("Crafting: Successes") and ch.cc_exists("Crafting: Failures"):
        success_cc = ch.cc("Crafting: Successes")
        failure_cc = ch.cc("Crafting: Failures")

        if settings_dict["pro_rate_refund"] and success_cc.value != success_cc.max and failure_cc.value != failure_cc.max and crafting_dict["crafting_cost"] != 0:

            percentage_back = (1 - ((success_cc.value / success_cc.max) + (failure_cc.value /(failure_cc.max * 2)))) * .5

            if percentage_back < 0:
                money_given_back = 0

            else:
                money_given_back = abs(round(percentage_back * crafting_dict["crafting_cost"], 2))

        else:
            money_given_back = 0

        money_taken_back = abs(crafting_dict["backup"]["money_back"]) * -1

        if (money_back := (money_given_back * -1) + (money_taken_back * -1)) > ch.coinpurse.total:
            return "You Have Been Sneak Attacked by an Error", "You cannot restore this item because you do not have the funds to do so", error_img, "#CF142B"

        else:
            money_back = money_back * -1

            # Grab gold, silver, and copper amounts
            gold = floor(money_back)
            silver = floor((money_back * 10) % 10)
            copper = floor((money_back * 100) % 10)

            # Subtract cost from coin purse
            ch.coinpurse.modify_coins(
                gp=gold,
                sp=silver,
                cp=copper)

        temp_dict = dump_json(crafting_dict["backup"])

        crafting_dict["backup"]["cvar"][0] = crafting_dict["name"]
        crafting_dict["backup"]["cvar"][1] = crafting_dict["category"]
        crafting_dict["backup"]["cvar"][2] = crafting_dict["type"]
        crafting_dict["backup"]["cvar"][3] = crafting_dict["time"]
        crafting_dict["backup"]["cvar"][4] = crafting_dict["cooldown"]
        crafting_dict["backup"]["cvar"][5] = crafting_dict["crafting_cost"]
        crafting_dict["backup"]["cvar"][6] = crafting_dict["stat"]
        crafting_dict["backup"]["cvar"][7] = crafting_dict["succ_mult"]

        crafting_dict["backup"]["money_back"] = money_given_back

        # Puts the counter values into backup
        crafting_dict["backup"]["success_cc"][0] = success_cc.value
        crafting_dict["backup"]["success_cc"][1] = success_cc.max
        crafting_dict["backup"]["success_cc"][2] = success_cc.desc
        crafting_dict["backup"]["success_cc"][3] = success_cc.title

        crafting_dict["backup"]["failure_cc"][0] = failure_cc.value
        crafting_dict["backup"]["failure_cc"][1] = failure_cc.max
        crafting_dict["backup"]["failure_cc"][2] = failure_cc.desc
        crafting_dict["backup"]["failure_cc"][3] = failure_cc.title

        temp_dict = load_json(temp_dict)

        crafting_dict["name"] = temp_dict["cvar"][0]
        crafting_dict["category"] = temp_dict["cvar"][1]
        crafting_dict["type"] = temp_dict["cvar"][2]
        crafting_dict["time"] = temp_dict["cvar"][3]
        crafting_dict["cooldown"] = temp_dict["cvar"][4]
        crafting_dict["crafting_cost"] = temp_dict["cvar"][5]
        crafting_dict["stat"] = temp_dict["cvar"][6]
        crafting_dict["succ_mult"] = temp_dict["cvar"][7]

        success_dispType = success_cc.display_type
        failure_dispType = failure_cc.display_type

        # Delete old ccs
        ch.delete_cc('Crafting: Successes')
        ch.delete_cc('Crafting: Failures')

        # Create new ccs
        success_cc = ch.create_cc(
            name="Crafting: Successes",
            minVal="0",
            maxVal=str(temp_dict['success_cc'][1]),
            reset='none',
            dispType=success_dispType,
            title=temp_dict['success_cc'][3],
            desc=temp_dict['success_cc'][2],
            initial_value=str(temp_dict['success_cc'][0])
        )

        failure_cc = ch.create_cc(
            name="Crafting: Failures",
            minVal="0",
            maxVal=str(temp_dict['failure_cc'][1]),
            reset='none',
            dispType=success_dispType,
            title=temp_dict['failure_cc'][3],
            desc=temp_dict['failure_cc'][2],
            initial_value=str(temp_dict['failure_cc'][0])
        )

    # If there is not an active crafting session
    else:

        if crafting_dict["backup"]["money_back"] != 0:

            if (money_back := abs(crafting_dict["backup"]["money_back"])) > ch.coinpurse.total:
                return "You Have Been Sneak Attacked by an Error", "You cannot restore this item because you do not have the funds to do so", error_img, "#CF142B"

            else:

                money_back = money_back * - 1

                # Grab gold, silver, and copper amounts
                gold = floor(money_back)
                silver = floor((money_back * 10) % 10)
                copper = floor((money_back * 100) % 10)

                # Subtract cost from coin purse
                ch.coinpurse.modify_coins(
                    gp=gold,
                    sp=silver,
                    cp=copper)

        else:
            money_back = 0

        # Puts items from backup into main CVAR
        crafting_dict["name"] = crafting_dict["backup"]["cvar"][0]
        crafting_dict["category"] = crafting_dict["backup"]["cvar"][1]
        crafting_dict["type"] = crafting_dict["backup"]["cvar"][2]
        crafting_dict["time"] = crafting_dict["backup"]["cvar"][3]
        crafting_dict["cooldown"] = crafting_dict["backup"]["cvar"][4]
        crafting_dict["crafting_cost"] = crafting_dict["backup"]["cvar"][5]
        crafting_dict["stat"] = crafting_dict["backup"]["cvar"][6]

        success_cc = ch.create_cc(
            name="Crafting: Successes",
            minVal="0",
            maxVal=str(crafting_dict["backup"]["success_cc"][1]),
            reset="none",
            dispType=settings_dict["success_dispType"],
            title=crafting_dict["backup"]["success_cc"][3],
            desc=crafting_dict["backup"]["success_cc"][2],
            initial_value=str(crafting_dict["backup"]["success_cc"][0])
        )

        failure_cc = ch.create_cc(
            name="Crafting: Failures",
            minVal="0",
            maxVal=str(crafting_dict["backup"]["failure_cc"][1]),
            reset="none",
            dispType=settings_dict["failure_dispType"],
            title=crafting_dict["backup"]["failure_cc"][3],
            desc=crafting_dict["backup"]["failure_cc"][2],
            initial_value=str(crafting_dict["backup"]["failure_cc"][0])
        )

        crafting_dict.pop("backup")

    # Tries to pull a color
    try:
        crafting_dict["color"] = settings_dictionary[crafting_dict["category"]][crafting_dict["type"]][-1]

    # Random color if fail
    except:
        crafting_dict["color"] = ""

    # Save cvar
    ch.set_cvar("crafting_dict", dump_json(crafting_dict))
    crafting_dict = load_json(ch.get_cvar("crafting_dict"))

    result_string = []

    # Success counter
    result_string.append(f"Successes: {success_cc.value}/{success_cc.max}")

    if f"{success_cc.value}/{success_cc.max}" != ch.cc_str("Crafting: Successes"):
        result_string.append(ch.cc_str("Crafting: Successes"))

    # Failure counter
    result_string.append(f"Failures: {failure_cc.value}/{failure_cc.max}")

    if f"{failure_cc.value}/{failure_cc.max}" != ch.cc_str("Crafting: Failures"):
        result_string.append(ch.cc_str("Crafting: Failures"))

    try:
        color = crafting_dict["color"]

    except:
        color = color


    if money_back > 0:
        result_string.append(f"\nYou have received a net gain of {money_back}gp")

    elif money_back < 0:
        result_string.append(f"\nYou have taken a net loss of {abs(money_back)}gp")

    return f"{name} Has Restored Their Crafting Progress For a {crafting_dict['name']}", "\n".join(result_string), "https://raw.githubusercontent.com/Shadow-Draconic-Development/Avrae-Customizable-Crafting-System/refs/heads/main/Data/images/hammer.png", color


# Main program
title, f, thumb, color = main()


</drac2>
-title "{{title}}"
-f "{{f}}"
-thumb "{{thumb}}"
-color "{{color}}"
-footer "{{ctx.prefix}}craft restore | 4/5/26 | ShadowsStride"